In LoanRecoveryService:

public function getEmployeeLoanSummary(
    int $employeeId,
    float $grossSalary,
    int $month,
    int $year
): array {

    $loans = Penalty::where(
            'employee_id',
            $employeeId
        )
        ->where('recovery_type', 'loans')
        ->get();

    if ($loans->isEmpty()) {
        return [
            'has_loan' => false,
            'total_loan_amount' => 0,
            'total_recovered' => 0,
            'remaining_amount' => 0,
            'current_installment' => 0,
            'current_installment_number' => null,
            'total_installments' => 0,
            'maximum_allowed_this_month' =>
                $this->maximumMonthlyDeduction($grossSalary),
        ];
    }

    $totalLoanAmount = 0;
    $totalRecovered = 0;
    $currentInstallment = 0;
    $currentInstallmentNumber = null;
    $totalInstallments = 0;

    foreach ($loans as $loan) {

        $loanAmount =
            (float) $loan->calculation_amount;

        $totalLoanAmount += $loanAmount;

        $recovered = (float) $loan
            ->loanInstallments()
            ->whereIn(
                'status',
                ['deducted', 'pending']
            )
            ->sum('installment_amount');

        $totalRecovered += $recovered;

        $current = $loan
            ->loanInstallments()
            ->where('month', $month)
            ->where('year', $year)
            ->where('status', 'deducted')
            ->first();

        if ($current) {
            $currentInstallment +=
                (float) $current->installment_amount;

            $currentInstallmentNumber =
                $current->installment_number;
        }

        $totalInstallments +=
            $loan->loanInstallments()
                ->whereIn(
                    'status',
                    ['deducted', 'pending']
                )
                ->count();
    }

    return [
        'has_loan' => true,

        'total_loan_amount' =>
            round($totalLoanAmount, 2),

        'total_recovered' =>
            round($totalRecovered, 2),

        'remaining_amount' =>
            round(
                max(
                    0,
                    $totalLoanAmount -
                    $totalRecovered
                ),
                2
            ),

        'current_installment' =>
            round($currentInstallment, 2),

        'current_installment_number' =>
            $currentInstallmentNumber,

        'total_installments' =>
            $totalInstallments,

        'maximum_allowed_this_month' =>
            $this->maximumMonthlyDeduction(
                $grossSalary
            ),
    ];
}

